# ---------------------------------------------------------------------------
# Copy to .env.local (Next.js) and .env (Prisma CLI) and fill in.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://alon:alon@localhost:5432/alon?schema=public

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Licensing — Ed25519 keypair used to sign licence payloads
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Object storage (S3-compatible) for installers and cloud backup
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_ARTIFACTS=alon-artifacts
S3_BUCKET_BACKUPS=alon-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email / SMS
RESEND_API_KEY=
EMAIL_FROM="Alon Software <noreply@alonsoftware.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
